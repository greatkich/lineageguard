# Application
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# LLM runtime (OmniRoute)
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=
OMNIROUTE_API_KEY=

# LineageGuard PostgreSQL
LINEAGEGUARD_DATABASE_URL=postgresql://lineageguard:lineageguard@localhost:5432/lineageguard

# DataHub
DATAHUB_GMS_URL=http://127.0.0.1:8080
DATAHUB_FRONTEND_URL=http://localhost:9002
DATAHUB_TOKEN=
DATAHUB_READ_TOKEN=
DATAHUB_BOOTSTRAP_TOKEN=
DATAHUB_INGEST_TOKEN=
DATAHUB_MUTATION_TOKEN=
DATAHUB_MCP_TRANSPORT=stdio
DATAHUB_MCP_MUTATIONS_ENABLED=false

# GitHub
GITHUB_OWNER=greatkich
GITHUB_REPO=lineageguard
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Source PR (set to analyse a real unsafe PR)
SOURCE_PR_NUMBER=

# Git SHAs (required when SOURCE_PR_NUMBER is not set)
LINEAGEGUARD_BASE_SHA=
LINEAGEGUARD_HEAD_SHA=

# Walkthrough
LINEAGEGUARD_MODE=live
LINEAGEGUARD_REPOSITORY=greatkich/lineageguard
LINEAGEGUARD_CANONICAL_SCENARIO=rename-customer-id
LINEAGEGUARD_REPLAY_RUN_ID=

# Validation runtime (Docker-based 8-check validation)
VALIDATION_ENABLED=true
VALIDATION_DOCKER_EXECUTABLE=/usr/bin/docker
VALIDATION_RUNNER_IMAGE_ID=
VALIDATION_POSTGRES_IMAGE_ID=
VALIDATION_BASE_FIXTURE_PATH=
VALIDATION_SANDBOX_ROOT=/tmp

# Write-back (enabled for LIVE mode)
WRITEBACK_ENABLED=true
WRITEBACK_REQUIRE_APPROVAL=true

# Deployment
PUBLIC_APP_URL=
