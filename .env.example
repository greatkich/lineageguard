# Application
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# OpenAI runtime
OPENAI_API_KEY=
OPENAI_MODEL=

# LineageGuard PostgreSQL control/walkthrough store
DATABASE_URL=postgresql://lineageguard:lineageguard@localhost:5432/lineageguard

# DataHub
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_FRONTEND_URL=http://localhost:9002
DATAHUB_TOKEN=
DATAHUB_MCP_TRANSPORT=stdio
DATAHUB_MCP_MUTATIONS_ENABLED=false

# GitHub live mode — use a fine-grained token or GitHub App credentials
GITHUB_OWNER=greatkich
GITHUB_REPOSITORY=lineageguard
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Walkthrough
LINEAGEGUARD_MODE=live
LINEAGEGUARD_CANONICAL_SCENARIO=rename-customer-id
LINEAGEGUARD_REPLAY_RUN_ID=

# Write-back safety
WRITEBACK_ENABLED=false
WRITEBACK_REQUIRE_APPROVAL=true

# Deployment
PUBLIC_APP_URL=
