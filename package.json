{
  "name": "lineageguard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.20.0 <12.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:environment": "sh scripts/check-environment.sh",
    "demo": "pnpm build && node --import tsx scripts/demo.ts",
    "dev": "pnpm --filter @lineageguard/web dev",
    "dev:worker": "pnpm --filter @lineageguard/worker build && pnpm --filter @lineageguard/worker start",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "setup:browsers": "sh scripts/setup-playwright.sh",
    "test": "node --test scripts/*.test.mjs && pnpm check:boundaries && vitest run",
    "test:e2e": "playwright test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "walkthrough:verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pg": "^8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tsx": "^4.23.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
